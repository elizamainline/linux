config NFC_ST21NFC_I2C
	tristate "STMicroelectronics ST21NFC raw NCI over I2C"
	depends on NFC_NCI && I2C && GPIOLIB
	help
	  Driver for ST21NFC controllers which exchange unframed NCI packets
	  over I2C, including the ST54L in Nothing Phone (4a) Pro.
	  This is distinct from the ST NCI driver using the NDLC transport.

	  If built as a module, it will be called st21nfc_i2c.
